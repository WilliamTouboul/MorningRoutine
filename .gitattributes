# Normalize line endings: LF in the repository and in the working tree,
# on every OS. Code runs in Linux containers, where CRLF breaks shell
# scripts and shebangs.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files: never touch them.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.zip   binary
*.gz    binary
