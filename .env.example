# Copy this file to .env and replace every "change-me" value.
# .env is git-ignored and must never be committed.
#
# Use letters and digits only for passwords (they are inserted into SQL).
# Generate one with:  openssl rand -hex 24

# --- MySQL ------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me
# Port on your machine for a SQL client (HeidiSQL, TablePlus…). 3307 avoids
# clashing with a local MySQL that may already use 3306.
MYSQL_HOST_PORT=3307

# --- Legacy WordPress (PHP 7.4) ---------------------------------------------
WP_LEGACY_DB_NAME=wp_legacy
WP_LEGACY_DB_USER=wp_legacy
WP_LEGACY_DB_PASSWORD=change-me

# --- Modern WordPress (PHP 8.3) ---------------------------------------------
WP_MODERN_DB_NAME=wp_modern
WP_MODERN_DB_USER=wp_modern
WP_MODERN_DB_PASSWORD=change-me

# --- Dashboard (Laravel) ----------------------------------------------------
DASHBOARD_DB_NAME=dashboard
DASHBOARD_DB_USER=dashboard
DASHBOARD_DB_PASSWORD=change-me
